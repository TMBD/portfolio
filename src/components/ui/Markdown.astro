---
/**
 * Markdown — renders a trusted, first-party Markdown string as themed HTML.
 *
 * Descriptions in `src/data/*` are authored in Markdown (often via the `md`
 * tagged-template for clean multi-line source). This component converts them to
 * HTML at build time and styles them with the typography plugin — justified and
 * mapped to the site's theme tokens so the same markup looks right in both light
 * and dark mode. External HTTP(S) links open safely in a new tab while internal
 * links keep normal navigation. The content is authored by us (never user input),
 * so rendering it with `set:html` is safe here.
 */
import { Marked, Renderer, type Tokens } from "marked";
import { isExternalHttpHref } from "../../plugins/externalLinks.mjs";

interface Props {
  /** Markdown source to render. */
  text: string;
  /** Extra classes for the wrapper (e.g. spacing). */
  class?: string;
}

const { text, class: className } = Astro.props;

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;

class ExternalLinkRenderer extends Renderer {
  override link(token: Tokens.Link): string {
    const html = super.link(token);
    return isExternalHttpHref(token.href, siteOrigin)
      ? html.replace(
          "<a ",
          '<a target="_blank" rel="noopener noreferrer" ',
        )
      : html;
  }
}

const markdown = new Marked({ renderer: new ExternalLinkRenderer() });
const html = markdown.parse(text, { async: false });
---

<div
  class:list={[
    "prose prose-portfolio max-w-none text-justify hyphens-auto",
    className,
  ]}
  set:html={html}
/>
